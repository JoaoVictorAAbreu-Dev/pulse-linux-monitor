#!/bin/sh
# Abre o painel do Pulse no navegador padrão. Se o serviço de usuário não
# estiver rodando, tenta iniciá-lo antes.
set -u
if ! curl -fs -m 1 -o /dev/null http://127.0.0.1:7878/api/health 2>/dev/null; then
  systemctl --user start pulse.service 2>/dev/null || true
  i=0
  while [ $i -lt 20 ] && ! curl -fs -m 1 -o /dev/null http://127.0.0.1:7878/api/health 2>/dev/null; do
    sleep 0.25; i=$((i + 1))
  done
fi
url=$(pulse --print-token) || exit 1
exec xdg-open "$url"
