#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
  # O serviço de usuário NÃO é habilitado automaticamente: cada usuário decide.
  cat <<'MSG'

Pulse instalado. Abra "Pulse" no menu de aplicativos (ou rode pulse-open).
Para iniciar junto com a sessão, habilite o serviço de usuário "pulse"
(instruções em: man pulse).

MSG
fi
exit 0
